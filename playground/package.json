{
  "name": "playground",
  "private": true,
  "version": "0.1.0",
  "description": "The three-layer MCP Apps workbench: native Vue card, sandboxed MCP App (host → proxy → view), protocol inspector.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:cards -w demo-cards && concurrently -k -n cards,web -c magenta,cyan \"npm run watch:cards -w demo-cards\" \"vite\"",
