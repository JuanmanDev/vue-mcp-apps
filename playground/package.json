    "@nuxt/ui": "^4.11.3",
    "@vue-mcp-apps/core": "0.1.0",
    "@vue-mcp-apps/server": "0.1.0",
    "@vue-mcp-apps/view": "0.1.0",
    "demo-cards": "0.1.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.34",
    "vue-router": "^5.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
