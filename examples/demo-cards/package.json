{
  "name": "demo-cards",
  "private": true,
  "version": "0.1.0",
  "description": "Example: three Vue + Nuxt UI cards served as MCP Apps by a real MCP server (stdio, HTTP, or in the browser).",
  "type": "module",
  "exports": {
    "./manifest": "./src/manifest.ts",
    "./components": "./src/components.ts",
    "./server": "./src/server/createServer.ts",
    "./cards.json": "./dist/cards.json"
  },
  "scripts": {
    "build:cards": "vite build -c vite.cards.config.ts",
    "watch:cards": "vite build -c vite.cards.config.ts --watch",
    "server:http": "tsx --conditions=vue-mcp-apps:source src/server/http.ts",
    "server:stdio": "tsx --conditions=vue-mcp-apps:source src/server/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nuxt/ui": "^4.11.3",
    "@vue-mcp-apps/core": "0.1.0",
    "@vue-mcp-apps/server": "0.1.0",
    "@vue-mcp-apps/view": "0.1.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.34",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.146",
    "@vue-mcp-apps/vite": "0.1.0"
  }
}
